class Solution {
public:
    string removeOuterParentheses(string s) {
        int b=0; int start=0;
        int i=0;
        while(i<s.size()){
            if(s[i]=='('){
                b++;
                i++;
            }else if(s[i]==')'){
                b--;
                i++;
            }
            if(b==0){
                s.erase(i-1,1);
                s.erase(start,1);
                i=i-2;
                start=i;
                
            }
        }
        return s;
    }
};
